@page
@model employee_management.Pages.Leave.IndexModel
@{
    ViewData["Title"] = "Leave Requests";
}
<h2>Leave Requests</h2>
<form class="mb-4">
    <div class="row g-2">
        <div class="col-md-4">
            <input class="form-control" placeholder="Leave type (vacation, sick)" />
        </div>
        <div class="col-md-3">
            <input type="date" class="form-control" />
        </div>
        <div class="col-md-3">
            <input type="date" class="form-control" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100">Submit</button>
        </div>
    </div>
</form>
<table class="table">
    <thead>
        <tr>
            <th>Employee</th>
            <th>Type</th>
            <th>Dates</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Alice Johnson</td>
            <td>Vacation</td>
            <td>2024-05-01 - 2024-05-10</td>
            <td><span class="badge text-bg-warning">Pending</span></td>
        </tr>
        <tr>
            <td>Bob Smith</td>
            <td>Sick</td>
            <td>2024-04-03 - 2024-04-05</td>
            <td><span class="badge text-bg-success">Approved</span></td>
        </tr>
    </tbody>
</table>
