@page
@model employee_management.Pages.Assets.AddModel
@{
    ViewData["Title"] = "Add Fixed Asset";
}
<h2>Add New Fixed Asset</h2>
<form method="post">
    <div class="mb-3">
        <label asp-for="Asset.AssetNo" class="form-label"></label>
        <input asp-for="Asset.AssetNo" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Asset.Description" class="form-label"></label>
        <input asp-for="Asset.Description" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Asset.Category" class="form-label"></label>
        <input asp-for="Asset.Category" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Asset.SerialNo" class="form-label"></label>
        <input asp-for="Asset.SerialNo" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Asset.Model" class="form-label"></label>
        <input asp-for="Asset.Model" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Asset.ResponsibleEmployee" class="form-label"></label>
        <input asp-for="Asset.ResponsibleEmployee" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Asset.Status" class="form-label"></label>
        <input asp-for="Asset.Status" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
