@page
@model employee_management.Pages.Assets.IndexModel
@{
    ViewData["Title"] = "Fixed Assets";
}
<h2 class="text-2xl font-semibold mb-4">Fixed Assets</h2>
<a asp-page="Add" class="inline-block mb-4 bg-green-600 text-white px-4 py-2 rounded">Add New Asset</a>
<table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
        <tr>
            <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">AssetNo</th>
            <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Description</th>
            <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Category</th>
            <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">SerialNo</th>
            <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Model</th>
            <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Responsible Employee</th>
            <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Status</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var asset in Model.AssetList)
    {
        <tr class="border-b">
            <td class="px-4 py-2">@asset.AssetNo</td>
            <td class="px-4 py-2">@asset.Description</td>
            <td class="px-4 py-2">@asset.Category</td>
            <td class="px-4 py-2">@asset.SerialNo</td>
            <td class="px-4 py-2">@asset.Model</td>
            <td class="px-4 py-2">@asset.ResponsibleEmployee</td>
            <td class="px-4 py-2">@asset.Status</td>
        </tr>
    }
    </tbody>
</table>
