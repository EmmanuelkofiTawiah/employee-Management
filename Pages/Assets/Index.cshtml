@page
@model employee_management.Pages.Assets.IndexModel
@{
    ViewData["Title"] = "Fixed Assets";
}
<h2>Fixed Assets</h2>
<a asp-page="Add" class="btn btn-success mb-3">Add New Asset</a>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>AssetNo</th>
            <th>Description</th>
            <th>Category</th>
            <th>SerialNo</th>
            <th>Model</th>
            <th>Responsible Employee</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var asset in Model.AssetList)
    {
        <tr>
            <td>@asset.AssetNo</td>
            <td>@asset.Description</td>
            <td>@asset.Category</td>
            <td>@asset.SerialNo</td>
            <td>@asset.Model</td>
            <td>@asset.ResponsibleEmployee</td>
            <td>@asset.Status</td>
        </tr>
    }
    </tbody>
</table>
