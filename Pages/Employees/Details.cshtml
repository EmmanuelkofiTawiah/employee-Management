@page
@model employee_management.Pages.Employees.DetailsModel
@{
    ViewData["Title"] = "Employee Profile";
}
@if (Model.Employee == null)
{
    <p>Employee not found.</p>
}
else
{
    <h2 class="text-2xl font-semibold mb-4">@Model.Employee.Name</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <p><strong>Department:</strong> @Model.Employee.Department</p>
            <p><strong>Status:</strong> @Model.Employee.Status</p>
            <p><strong>Role:</strong> @Model.Employee.Role</p>
        </div>
        <div>
            <p><strong>Email:</strong> @Model.Employee.Email</p>
            <p><strong>Phone:</strong> @Model.Employee.Phone</p>
        </div>
    </div>
    <a asp-page="Index" class="inline-block mt-4 text-blue-600 hover:underline">Back to Directory</a>
}
