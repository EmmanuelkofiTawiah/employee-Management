@page
@model employee_management.Pages.Clients.AddModel
@{
    ViewData["Title"] = "Add Client";
}
<h2 class="text-2xl font-semibold mb-4">Add New Client</h2>
<form method="post" class="space-y-4">
    <div>
        <label asp-for="Client.Code" class="block font-semibold mb-1"></label>
        <input asp-for="Client.Code" class="border rounded px-3 py-2 w-full" />
    </div>
    <div>
        <label asp-for="Client.Name" class="block font-semibold mb-1"></label>
        <input asp-for="Client.Name" class="border rounded px-3 py-2 w-full" />
    </div>
    <div>
        <label asp-for="Client.Address" class="block font-semibold mb-1"></label>
        <input asp-for="Client.Address" class="border rounded px-3 py-2 w-full" />
    </div>
    <div>
        <label asp-for="Client.Phone" class="block font-semibold mb-1"></label>
        <input asp-for="Client.Phone" class="border rounded px-3 py-2 w-full" />
    </div>
    <div>
        <label asp-for="Client.Email" class="block font-semibold mb-1"></label>
        <input asp-for="Client.Email" class="border rounded px-3 py-2 w-full" />
    </div>
    <div>
        <label asp-for="Client.Status" class="block font-semibold mb-1"></label>
        <input asp-for="Client.Status" class="border rounded px-3 py-2 w-full" />
    </div>
    <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded">Save</button>
    <a asp-page="Index" class="ml-2 text-gray-700 hover:underline">Cancel</a>
</form>
